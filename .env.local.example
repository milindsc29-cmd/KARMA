# === Supabase Configuration ===
# Get these values from your Supabase project settings
# 1. Go to https://supabase.com and create a project
# 2. In Project Settings → API, copy the URL and anon key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === Admin Dashboard ===
# Password for accessing /admin/blog dashboard
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# === Background Image (Optional) ===
# Place watermarked_img_11443283127393356644.png in the /public folder
# The app will automatically load it when configured
